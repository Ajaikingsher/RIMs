generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id          String       @id @default(cuid())
  title       String
  description String
  date        DateTime
  location    String?
  category    String?
  featured    Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      EventImage[]
}

model EventImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Leadership {
  id            String   @id @default(cuid())
  name          String
  role          String
  bio           String?
  image         String?
  imagePosition String?  @default("50% 20%")
  isVisible     Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Download {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  organization String?
  inquiryType  String?
  subject      String?
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String?
  createdAt DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model addresses {
  id                                         String      @id
  userId                                     String
  type                                       AddressType @default(SHIPPING)
  name                                       String
  phone                                      String
  line1                                      String
  line2                                      String?
  city                                       String
  state                                      String
  pincode                                    String
  country                                    String      @default("India")
  isDefault                                  Boolean     @default(false)
  createdAt                                  DateTime    @default(now())
  users                                      users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders_orders_billingAddressIdToaddresses  orders[]    @relation("orders_billingAddressIdToaddresses")
  orders_orders_shippingAddressIdToaddresses orders[]    @relation("orders_shippingAddressIdToaddresses")

  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id          String     @id
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  imageId     String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  products    products[]

  @@index([slug])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dealers {
  id              String       @id
  userId          String       @unique
  businessName    String
  gstNumber       String?      @unique
  panNumber       String?
  phone           String
  businessAddress String
  city            String
  state           String
  pincode         String
  status          DealerStatus @default(PENDING)
  creditLimit     Decimal      @default(0) @db.Decimal(10, 2)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  documents       Json?
  approvedAt      DateTime?
  approvedById    String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  users           users        @relation(fields: [userId], references: [id])
  quotations      quotations[]

  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inventory {
  id                String   @id
  productId         String   @unique
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime
  products          products @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id        String           @id
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  users     users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([read])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model order_items {
  id          String   @id
  orderId     String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  taxAmount   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  orders      orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  products    products @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  id                                            String        @id
  orderNumber                                   String        @unique
  userId                                        String
  status                                        OrderStatus   @default(PENDING)
  paymentStatus                                 PaymentStatus @default(PENDING)
  subtotal                                      Decimal       @db.Decimal(10, 2)
  taxAmount                                     Decimal       @db.Decimal(10, 2)
  shippingAmount                                Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount                                Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount                                   Decimal       @db.Decimal(10, 2)
  shippingAddressId                             String?
  billingAddressId                              String?
  notes                                         String?
  gstNumber                                     String?
  invoiceUrl                                    String?
  isDealer                                      Boolean       @default(false)
  createdAt                                     DateTime      @default(now())
  updatedAt                                     DateTime
  order_items                                   order_items[]
  addresses_orders_billingAddressIdToaddresses  addresses?    @relation("orders_billingAddressIdToaddresses", fields: [billingAddressId], references: [id])
  addresses_orders_shippingAddressIdToaddresses addresses?    @relation("orders_shippingAddressIdToaddresses", fields: [shippingAddressId], references: [id])
  users                                         users         @relation(fields: [userId], references: [id])
  payments                                      payments?

  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([status])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payments {
  id                String          @id
  orderId           String          @unique
  provider          PaymentProvider @default(MOCK)
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  metadata          Json?
  failureReason     String?
  refundId          String?
  refundAmount      Decimal?        @db.Decimal(10, 2)
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  orders            orders          @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_images {
  id        String   @id
  productId String
  url       String
  publicId  String
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  products  products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_specs {
  id        String   @id
  productId String
  label     String
  value     String
  unit      String?
  sortOrder Int      @default(0)
  products  products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id              String            @id
  name            String
  slug            String            @unique
  description     String
  shortDesc       String?
  sku             String            @unique
  price           Decimal           @db.Decimal(10, 2)
  dealerPrice     Decimal           @db.Decimal(10, 2)
  taxRate         Decimal           @default(18) @db.Decimal(5, 2)
  categoryId      String
  isActive        Boolean           @default(true)
  isFeatured      Boolean           @default(false)
  warrantyMonths  Int               @default(12)
  weight          Decimal?          @db.Decimal(8, 3)
  datasheetUrl    String?
  metaTitle       String?
  metaDesc        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  inventory       inventory?
  order_items     order_items[]
  product_images  product_images[]
  product_specs   product_specs[]
  categories      categories        @relation(fields: [categoryId], references: [id])
  quotation_items quotation_items[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([slug])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model quotation_items {
  id          String     @id
  quotationId String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal    @db.Decimal(10, 2)
  taxRate     Decimal    @db.Decimal(5, 2)
  taxAmount   Decimal    @db.Decimal(10, 2)
  totalPrice  Decimal    @db.Decimal(10, 2)
  products    products   @relation(fields: [productId], references: [id])
  quotations  quotations @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model quotations {
  id              String            @id
  quotationNo     String            @unique
  dealerId        String
  status          QuotationStatus   @default(PENDING)
  notes           String?
  adminNotes      String?
  subtotal        Decimal           @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal           @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal           @default(0) @db.Decimal(10, 2)
  validUntil      DateTime?
  pdfUrl          String?
  approvedById    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  quotation_items quotation_items[]
  dealers         dealers           @relation(fields: [dealerId], references: [id])

  @@index([dealerId])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id            String          @id
  name          String?
  email         String          @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  role          Role            @default(CUSTOMER)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  accounts      accounts[]
  addresses     addresses[]
  dealers       dealers?
  notifications notifications[]
  orders        orders[]
  sessions      sessions[]

  @@index([email])
  @@index([role])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AddressType {
  BILLING
  SHIPPING
}

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum NotificationType {
  ORDER
  PAYMENT
  QUOTATION
  DEALER
  INVENTORY
  SYSTEM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  MOCK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum QuotationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum Role {
  CUSTOMER
  DEALER
  ADMIN
}

model Milestone {
  id            String   @id @default(cuid())
  title         String
  description   String
  dateString    String?
  image         String
  imagePosition String?  @default("50% 20%")
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
